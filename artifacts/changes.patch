-    const [tab] = await chrome.tabs.query({ active: true, windowId: win.id });
-    if (!tab || !PORTAL_HOST.test(tab.url || '')) return null;
-    return tab.id;
-  } catch {
-    return null;                        // no windows API answer means nothing to protect
-  }
-}
