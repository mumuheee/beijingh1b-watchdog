-    return deepQueryAll('#datepicker td.greenday')
-      .map((td) => ({ td, iso: cellDateISO(td) }))
-      .filter((x) => x.iso && x.iso >= range.start && x.iso <= range.end)
-      .sort((a, b) => a.iso.localeCompare(b.iso))[0] || null;
-  }
